rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. SERVICES CATALOG & MULTI-IMAGE GALLERIES
    // Anyone can read services catalog (Laptop, PC, CCTV, Passport Photos).
    // Writes permitted for shop management.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. OWNER / LEAD TECHNICIAN PROFILE (Why Us Section)
    // Anyone can read owner profile.
    match /ownerProfile/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. REPAIR & SURVEY TICKETS
    // Public can create booking requests (with valid phone & customer name) and track tickets.
    // Shop management can update status, notes, costs, and delete tickets.
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.phone is string
                    && request.resource.data.serviceType is string;
      allow update, delete: if true;
    }

    // 4. CUSTOMER REVIEWS
    // Anyone can read approved customer reviews.
    // Customers can submit genuine reviews.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (request.resource.data.name is string || request.resource.data.reviewerName is string)
                    && request.resource.data.rating is number;
      allow update, delete: if true;
    }

    // 5. CONTACT INQUIRIES
    // Public can send contact messages.
    match /contacts/{contactId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.message is string;
      allow update, delete: if true;
    }
  }
}
